{
  "name": "dv-bot",
  "version": "2.0.0",
  "description": "High-performance multi-functional Discord Bot built with Bun and discord.js",
  "type": "module",
  "main": "src/bot.ts",
  "workspaces": [
    "src/web/frontend"
  ],
  "scripts": {
    "start": "bun run src/bot.ts",
    "dev": "bun --watch src/bot.ts",
    "typecheck": "tsc --noEmit",
    "install:all": "bun install && cd src/web/frontend && bun install",
    "build:web": "cd src/web/frontend && bun install && bun run build",
    "test": "bun test",
    "generate-secret": "bun -e \"console.log('\\nYour Secure Session Secret:\\n' + require('crypto').randomBytes(64).toString('hex') + '\\n')\""
  },
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
