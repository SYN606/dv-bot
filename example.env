# ==========================================
# ───── BOT ENVIRONMENT CONFIGURATION ─────
# ==========================================

# Application execution mode: 'prod', 'dev', or 'test'
ENV=prod

# Default command prefix (fallback when database prefix is unavailable)
PREFIX=dv

# Developer / Test Server ID for instant slash command registration (Used when ENV=test)
DEV_GUILD_ID=

# ==========================================
# ───── DISCORD APPLICATION SECRETS ────────
# ==========================================

# Bot User Token from Discord Developer Portal (REQUIRED)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID & Secret (Optional / Recommended)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Command Synchronization: Set to 'true' to register slash commands on startup
SYNC_COMMANDS=true

# Verbose HTTP Logging: Set to 'true' for raw API HTTP debug logs
DEBUG_HTTP=false

# ==========================================
# ───── DATABASE CONFIGURATION ─────────────
# ==========================================

# Supported Engine Types: sqlite | postgres | mysql
DB_TYPE=sqlite

# SQLite Configuration (Used when DB_TYPE=sqlite)
SQLITE_NAME=bot.db

# Direct Connection URI (Overrides individual credentials below if provided)
# Example: postgresql://user:pass@localhost:5432/dbname
DATABASE_URL=

# External Database Credentials (Used when DB_TYPE is postgres or mysql)
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_vigil
DB_SSL=false

# Danger Flag: Allows schema re-creation / drops during migration/testing
ALLOW_TABLE_DROP=false

# ==========================================
# ───── MEDIA & CDN ASSET URLS ─────────────
# ==========================================

# Interactive Embed Animated Assets
AFK_IMAGE_URL=https://cdn.discordapp.com/attachments/1476443404207652916/1512558268197765221/afk.gif
MENTION_GIF_URL=https://cdn.discordapp.com/attachments/1476443404207652916/1512558249474527344/mention.gif
HELP_BANNER_GIF=https://cdn.discordapp.com/attachments/1476443404207652916/1512558276418736178/help.gif