# ==========================================
# ───── BOT ENVIRONMENT CONFIGURATION ─────
# ==========================================

# Application execution mode: 'prod', 'dev', or 'test'
# Note: 'prod' and 'production' enforce strict SESSION_SECRET and production OAuth redirect.
ENV=dev

# Bot Display Name
BOT_NAME="Digital Vigital"

# Default command prefix (fallback when guild database prefix is unavailable)
PREFIX=dv

# Developer / Test Server ID for instant slash command registration (Used when ENV=test)
DEV_GUILD_ID=

# Command Synchronization: Set to 'true' to register slash commands with Discord API on startup
SYNC_COMMANDS=true

# Verbose HTTP Logging: Set to 'true' for raw Discord API HTTP debug logs
DEBUG_HTTP=false

# Bot Process Logging Level: debug | info | warn | error
LOG_LEVEL=info

# ==========================================
# ───── DISCORD APPLICATION SECRETS ────────
# ==========================================

# Bot User Token from Discord Developer Portal (REQUIRED)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID & Secret (Required for Web Dashboard OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Superusers / Bot Owners: Comma-separated Discord User IDs with root administrative bypass
SUPERUSER_IDS=

# ==========================================
# ───── BOT PRESENCE & STATUS ──────────────
# ==========================================

# Bot Status: online | idle | dnd | invisible
BOT_STATUS=idle

# Activity Type: PLAYING | STREAMING | LISTENING | WATCHING | COMPETING
BOT_ACTIVITY_TYPE=LISTENING

# Custom Activity Status Text (Leave empty for dynamic system rotation)
BOT_ACTIVITY_TEXT=

# Presence Rotation Interval (hours between status text transitions)
PRESENCE_ROTATE_HOURS=4.5

# ==========================================
# ───── RATE LIMITING & COOLDOWNS ──────────
# ==========================================

# Global rate limiting per user (bucket tokens allowed per interval in seconds)
GLOBAL_COOLDOWN_RATE=5
GLOBAL_COOLDOWN_PER=5.0

# ==========================================
# ───── DATABASE CONFIGURATION ─────────────
# ==========================================

# Supported Engine Types: sqlite | postgres | mysql
DB_TYPE=sqlite

# SQLite Configuration (Used when DB_TYPE=sqlite)
SQLITE_NAME=bot.db

# Database storage directory:
# Default (unset): Uses local '.DB_DND' directory inside project root.
# On production Linux VPS, uncomment below to keep database persistent outside the codebase:
# DB_DIR=/var/db

# Direct path to SQLite file (optional; overrides DB_DIR + SQLITE_NAME if provided)
# DB_STORAGE=/var/db/bot.db

# Direct Database URI (Overrides individual credentials below if provided)
# Example: postgresql://user:pass@localhost:5432/dbname
DATABASE_URL=

# External Database Credentials (Used when DB_TYPE is postgres or mysql without DATABASE_URL)
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_vigital
DB_SSL=false

# Danger Flag: Allows schema re-creation / drops during migration or testing
ALLOW_TABLE_DROP=false

# ==========================================
# ───── WEB DASHBOARD CONFIGURATION ────────
# ==========================================

# Port the internal Hono dashboard server binds to
DASHBOARD_PORT=3000

# Production domain URL (auto-selected when ENV=prod or ENV=production)
DASHBOARD_URL_PROD=https://bot.digitalvigital.fun

# Local development URL (auto-selected when ENV=dev or ENV=development)
DASHBOARD_URL_DEV=http://localhost:3000

# Explicit direct override (optional; overrides dev/prod auto-selection)
# DASHBOARD_URL=https://bot.digitalvigital.fun

# Secret used to HMAC-sign session cookies (REQUIRED in production)
SESSION_SECRET=dv-bot-super-secure-secret-key-2026

# ==========================================
# ───── MEDIA & CDN ASSET URLS ─────────────
# ==========================================

# Optional interactive embed animated assets (Leave empty to disable custom GIFs)
AFK_IMAGE_URL=
MENTION_GIF_URL=
HELP_BANNER_GIF=

# ==========================================
# ───── MUSIC & LAVALINK CONFIGURATION ─────
# ==========================================

# Enable or disable the music subsystem (true / false)
MUSIC_ENABLED=true

# Lavalink v4 Server Connection Details
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Default & Maximum Playback Volume (1-200)
MUSIC_DEFAULT_VOLUME=80
MUSIC_MAX_VOLUME=150

# Maximum songs allowed in a single guild queue
MUSIC_MAX_QUEUE_SIZE=250

# Inactivity timeout in seconds before the bot leaves an idle voice channel (e.g. 180s = 3 mins)
MUSIC_IDLE_TIMEOUT=180

# Default 24/7 Voice Channel Connection for new guilds
MUSIC_DEFAULT_247=false
